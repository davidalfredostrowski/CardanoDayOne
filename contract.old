import fs from "fs";

import {
  getLucid
} from "./lucid.js";


const blueprint =
  JSON.parse(
    fs.readFileSync(
      "./plutus.json",
      "utf8"
    )
  );


if (!blueprint.validators?.length) {
  throw new Error(
    "No validators found in plutus.json"
  );
}


const validatorBlueprint =
  blueprint.validators[0];


export const validator = {

  type: "PlutusV3",

  script:
    validatorBlueprint.compiledCode
};


export async function getScriptAddress() {

  const lucid =
    await getLucid();

  return lucid.utils.validatorToAddress(
    validator
  );
}
